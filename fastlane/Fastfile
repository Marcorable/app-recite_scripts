ROOT = File.expand_path('..', __dir__)

desc 'iOS와 Android 스토어 스크린샷을 모두 생성하고 검증합니다.'
lane :screenshots_all do
  Dir.chdir(ROOT) do
    sh('tool/store_assets/capture.sh all')
    sh('tool/store_assets/validate.sh')
  end
end

desc '생성된 양 플랫폼 스토어 에셋 규격만 검증합니다.'
lane :validate_store_assets do
  Dir.chdir(ROOT) do
    sh('tool/store_assets/validate.sh')
  end
end

platform :ios do
  desc 'iPhone 6.9형과 iPad 13형 기본·큰 글씨 스크린샷을 생성합니다.'
  lane :screenshots do
    Dir.chdir(ROOT) do
      sh('tool/store_assets/capture.sh ios')
    end
  end
end

platform :android do
  desc '서명된 AAB를 Google Play 내부 테스트 트랙에 배포합니다.'
  lane :internal do
    upload_to_play_store(
      package_name: 'com.marcorable.maltto',
      json_key_data: ENV.fetch('GOOGLE_PLAY_SERVICE_ACCOUNT_JSON'),
      aab: ENV.fetch('ANDROID_AAB_PATH'),
      track: 'internal',
      release_status: 'completed',
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )
  end

  desc 'Android phone 기본·큰 글씨 스크린샷을 생성합니다.'
  lane :screenshots do
    Dir.chdir(ROOT) do
      sh('tool/store_assets/capture.sh android')
    end
  end
end
